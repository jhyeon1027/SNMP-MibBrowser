<Window x:Class="SnmpMibBrowser.CommunityListWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Community list" Width="440" Height="520" MinWidth="360" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="HintText" Text="One community per line. They are tried from top to bottom until the device answers." TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" Margin="4,0,4,4"/>
  <TextBox x:Name="CommunitiesText" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" TextChanged="CommunitiesText_TextChanged"/>
  <DockPanel Grid.Row="2" LastChildFill="False"><TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource SubtleTextBrush}"/>
   <Button x:Name="CancelListButton" DockPanel.Dock="Right" Content="Cancel" IsCancel="True"/><Button x:Name="OkListButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="OK" Click="Ok_Click"/></DockPanel>
 </Grid>
</Window>
