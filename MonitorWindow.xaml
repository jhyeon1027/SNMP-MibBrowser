<Window x:Class="SnmpMibBrowser.MonitorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:SnmpMibBrowser;assembly=SnmpMibBrowser.Core" xmlns:local="clr-namespace:SnmpMibBrowser"
 Title="Monitor" Width="900" Height="680" MinWidth="620" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
 <DockPanel Margin="12" TextElement.Foreground="{DynamicResource TextBrush}">
  <WrapPanel DockPanel.Dock="Top">
   <TextBlock x:Name="IntervalLabel" Text="Interval" VerticalAlignment="Center" Margin="4,0,2,0"/><ComboBox x:Name="IntervalBox" Width="75" SelectionChanged="Settings_Changed"><ComboBoxItem Tag="1">1 s</ComboBoxItem><ComboBoxItem Tag="2">2 s</ComboBoxItem><ComboBoxItem Tag="5" IsSelected="True">5 s</ComboBoxItem><ComboBoxItem Tag="10">10 s</ComboBoxItem><ComboBoxItem Tag="30">30 s</ComboBoxItem></ComboBox>
   <TextBlock x:Name="HistoryLabel" Text="History" VerticalAlignment="Center" Margin="8,0,2,0"/><ComboBox x:Name="HistoryBox" Width="85" SelectionChanged="Settings_Changed"><ComboBoxItem Tag="10" IsSelected="True">10 min</ComboBoxItem><ComboBoxItem Tag="30">30 min</ComboBoxItem><ComboBoxItem Tag="60">60 min</ComboBoxItem></ComboBox>
   <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Content="▶  Start" Click="Start_Click"/><Button x:Name="PauseButton" Content="⏸  Pause" IsEnabled="False" Click="Pause_Click"/><Button x:Name="ClearHistoryButton" Content="⌫  Clear history" Click="ClearHistory_Click"/>
  </WrapPanel>
  <WrapPanel DockPanel.Dock="Top">
   <TextBlock x:Name="AddOidLabel" Text="OID" VerticalAlignment="Center" Margin="4,0,2,0"/><TextBox x:Name="AddOidBox" Width="260" VerticalContentAlignment="Center" KeyDown="AddOidBox_KeyDown"/><Button x:Name="AddButton" Content="+  Add" Click="Add_Click"/>
   <TextBlock x:Name="AddHintText" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource SubtleTextBrush}"/>
  </WrapPanel>
  <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Margin="4,6,4,0" Foreground="{DynamicResource SubtleTextBrush}"/>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Margin="0,6,0,0">
   <Grid>
    <TextBlock x:Name="EmptyText" Margin="16" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <ItemsControl x:Name="ItemsList">
      <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type core:MonitorItem}">
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <WrapPanel>
          <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="140" Margin="0" Padding="4,1" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" ToolTip="Click to rename"/>
          <TextBlock Text="{Binding Target}" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Oid}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"/>
         </WrapPanel>
         <WrapPanel Grid.Row="1" Margin="16,2,0,2">
          <TextBlock Text="{Binding Current}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding CurrentDetail}"/>
          <TextBlock Text="{Binding Stats}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"/>
          <TextBlock Text="{Binding Status}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#D2557F"/>
         </WrapPanel>
         <Button Grid.Column="1" Grid.RowSpan="2" Content="✕" Padding="8,2" VerticalAlignment="Top" ToolTip="Remove" Click="Remove_Click" Tag="{Binding}"/>
         <local:Sparkline Grid.Row="2" Grid.ColumnSpan="2" Height="70" Margin="16,2,0,0" Item="{Binding}"/>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
  </Border>
 </DockPanel>
</Window>
