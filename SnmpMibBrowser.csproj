<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SNMP MibBrowser</AssemblyName>
    <Product>SNMP MibBrowser</Product>
    <Description>Open-source SNMP MIB browser for Windows</Description>
    <RepositoryUrl>https://github.com/jhyeon1027/SNMP-MibBrowser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.7</Version>
    <AssemblyVersion>1.0.7.17</AssemblyVersion>
    <FileVersion>1.0.7.17</FileVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Core/ and Tui/ are separate projects; keep their sources out of this one. -->
  <ItemGroup>
    <Compile Remove="Core/**;Tui/**" />
    <None Remove="Core/**;Tui/**" />
    <Page Remove="Core/**;Tui/**" />
    <ProjectReference Include="Core/SnmpMibBrowser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>

</Project>
