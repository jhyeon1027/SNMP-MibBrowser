<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-independent SNMP logic shared by the Windows app (WPF) and the Linux terminal app (TUI). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SnmpMibBrowser</RootNamespace>
    <AssemblyName>SnmpMibBrowser.Core</AssemblyName>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
  </ItemGroup>

</Project>
