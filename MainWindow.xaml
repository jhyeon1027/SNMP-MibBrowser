<Window x:Class="SnmpMibBrowser.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SNMP MibBrowser" Height="850" Width="1380" MinHeight="690" MinWidth="1100" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource AccentBrush}" Padding="14,9">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Border Background="#392456" CornerRadius="5" Padding="3" Margin="0,0,10,0"><Image Source="Assets/AppIcon.png" Width="34" Height="34"/></Border><StackPanel><TextBlock Text="SNMP MibBrowser" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Network diagnostics and MIB explorer" Foreground="#E8DDF6" FontSize="11"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LoadMibButton" Click="LoadMibs_Click" Content="＋  Load MIB"/><Button x:Name="LoadFolderButton" Click="LoadMibFolder_Click" Content="▣  MIB folder"/><Separator Margin="8,2"/><Button x:Name="LanguageButton" Content="🌐" Click="LanguageButton_Click" Padding="10,6" FontSize="16" ToolTip="Switch language"/><Button x:Name="ThemeButton" Content="☾  Dark" Click="ThemeButton_Click" Padding="12,6"/></StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
   <StackPanel Orientation="Horizontal">
    <TextBlock x:Name="ToolbarTargetLabel2" Text="Target" VerticalAlignment="Center" Margin="3,0,2,0"/><TextBox x:Name="ToolbarHostBox" Width="175" Text="127.0.0.1" VerticalContentAlignment="Center" TextChanged="ToolbarHostBox_TextChanged" KeyDown="HostBox_KeyDown"/>
    <TextBlock x:Name="ToolbarProfileLabel" Text="Profile" VerticalAlignment="Center" Margin="8,0,2,0"/><ComboBox x:Name="ToolbarProfileBox" Width="155" HorizontalContentAlignment="Left" SelectionChanged="ToolbarProfileBox_SelectionChanged"/>
    <Separator Margin="10,2"/>
    <Button x:Name="GetButton" Click="Get_Click" Content="↓  GET"/><Button x:Name="NextButton" Click="GetNext_Click" Content="↧  GET NEXT"/><Button x:Name="WalkButton" Click="Walk_Click" Content="≋  WALK"/>
    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/><Separator Margin="10,2"/><Button x:Name="ClearButton" Click="ClearResults_Click" Content="⌫  Clear"/><Button x:Name="SettingsButton" Click="Settings_Click" Content="⚙  Options"/><Button x:Name="UpdateButton" Click="Update_Click" Content="↻  Updates"/><Button x:Name="AboutButton" Click="About_Click" Content="ⓘ  About"/>
   </StackPanel>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="335"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
    <Grid Margin="15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="MibLibraryTitle" Text="MIB library" FontSize="22" FontWeight="SemiBold" Margin="2,2,2,3"/>
     <StackPanel Grid.Row="1" Margin="0,7"><TextBlock x:Name="SearchLabel" Text="Search MIB tree" Foreground="{DynamicResource SubtleTextBrush}"/><DockPanel><Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Content="×" ToolTip="Clear search" Click="ClearSearch_Click" Padding="10,4"/><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Search by name, OID or description" Margin="0,2,4,0"/></DockPanel></StackPanel>
     <TreeView x:Name="MibTree" Grid.Row="2" SelectedItemChanged="MibTree_SelectedItemChanged" MouseDoubleClick="MibTree_MouseDoubleClick" PreviewMouseRightButtonDown="MibTree_PreviewMouseRightButtonDown"><TreeView.ContextMenu><ContextMenu><MenuItem x:Name="ContextGetItem" Header="GET" Click="ContextGet_Click"/><MenuItem x:Name="ContextNextItem" Header="GET NEXT" Click="ContextNext_Click"/><MenuItem x:Name="ContextWalkItem" Header="WALK" Click="ContextWalk_Click"/><Separator/><MenuItem x:Name="ContextCopyItem" Header="Copy OID" Click="ContextCopy_Click"/><MenuItem x:Name="ContextDetailsItem" Header="Show details" Click="ContextDetails_Click"/></ContextMenu></TreeView.ContextMenu></TreeView>
     <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="9" Margin="0,8,0,0"><TextBlock x:Name="MibStatus" Foreground="{DynamicResource SubtleTextBrush}" Text="Standard MIBs loaded" TextWrapping="Wrap"/></Border>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
   <Grid Grid.Column="2" Margin="15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="WorkspaceTitle" Text="SNMP workspace" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceSubtitle" Text="Query devices and inspect management information." Foreground="{DynamicResource SubtleTextBrush}" FontSize="14" Margin="0,2,0,10"/></StackPanel>
    <Expander x:Name="WorkspacePanel" Grid.Row="1" Header="SNMP configuration" IsExpanded="True" Background="{DynamicResource SurfaceBrush}" Margin="7" Padding="0">
     <GroupBox x:Name="ConnectionGroup" Header="Connection"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="170"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="70"/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="ToolbarTargetLabel" Text="Target" VerticalAlignment="Center"/><TextBox x:Name="HostBox" Grid.Column="1" Text="127.0.0.1" TextChanged="HostBox_TextChanged" KeyDown="HostBox_KeyDown"/>
       <TextBlock x:Name="ProfileLabel" Grid.Column="2" Text="Profile" VerticalAlignment="Center"/><ComboBox x:Name="ProfileBox" Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" SelectionChanged="ProfileBox_SelectionChanged"/>
       <TextBlock x:Name="PortLabel" Grid.Column="4" Text="Port" VerticalAlignment="Center"/><TextBox x:Name="PortBox" Grid.Column="5" Text="161"/>
       <TextBlock x:Name="VersionLabel" Grid.Column="6" Text="Version" VerticalAlignment="Center"/><ComboBox x:Name="VersionBox" Grid.Column="7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" SelectionChanged="VersionBox_SelectionChanged"><ComboBoxItem>v1</ComboBoxItem><ComboBoxItem IsSelected="True">v2c</ComboBoxItem><ComboBoxItem>v3</ComboBoxItem></ComboBox>
      </Grid>
      <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="CommunityLabel" Text="Community" VerticalAlignment="Center"/><TextBox x:Name="CommunityBox" Grid.Column="1" Text="public"/>
       <WrapPanel x:Name="V3Panel" Grid.Column="2" Visibility="Collapsed"><TextBlock Text="User" VerticalAlignment="Center"/><TextBox x:Name="UserBox" Width="105"/><TextBlock Text="Auth" VerticalAlignment="Center"/><ComboBox x:Name="AuthBox" Width="95" HorizontalAlignment="Left" HorizontalContentAlignment="Left"><ComboBoxItem IsSelected="True">Keine</ComboBoxItem><ComboBoxItem>MD5</ComboBoxItem><ComboBoxItem>SHA-1</ComboBoxItem><ComboBoxItem>SHA-256</ComboBoxItem><ComboBoxItem>SHA-384</ComboBoxItem><ComboBoxItem>SHA-512</ComboBoxItem></ComboBox><PasswordBox x:Name="AuthPasswordBox" Width="105"/><TextBlock Text="Privacy" VerticalAlignment="Center"/><ComboBox x:Name="PrivacyBox" Width="95" HorizontalAlignment="Left" HorizontalContentAlignment="Left"><ComboBoxItem IsSelected="True">Keine</ComboBoxItem><ComboBoxItem>DES</ComboBoxItem><ComboBoxItem>AES-128</ComboBoxItem><ComboBoxItem>AES-192</ComboBoxItem><ComboBoxItem>AES-256</ComboBoxItem></ComboBox><PasswordBox x:Name="PrivacyPasswordBox" Width="105"/><TextBlock Text="Context" VerticalAlignment="Center"/><TextBox x:Name="ContextBox" Width="100"/></WrapPanel>
      </Grid>
     </StackPanel></GroupBox>
    </Expander>
    <Expander x:Name="DetailsPanel" Grid.Row="2" Header="MIB details" IsExpanded="False" Margin="7" Padding="8" Background="{DynamicResource SurfaceBrush}"><TextBox x:Name="DetailsBox" Height="130" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10" FontFamily="Consolas" BorderThickness="0"/></Expander>
    <TabControl x:Name="DataTabs" Grid.Row="3" Margin="7"><TabItem x:Name="ResultsTab" Header="Results"><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="80"/><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="85"/><DataGridTextColumn Header="OID" Binding="{Binding Oid}" Width="220"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="75"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem x:Name="WalkTableTab" Header="WALK table"><DataGrid x:Name="WalkTableGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"/></TabItem>
     <TabItem x:Name="SetTab" Header="SNMP SET"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SetOidLabel" Text="OID" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="SetOidBox" Grid.Column="1"/><TextBlock x:Name="DataTypeLabel" Grid.Row="1" Text="Data type" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="DataTypeBox" Grid.Row="1" Grid.Column="1" Width="240" HorizontalAlignment="Left"><ComboBoxItem IsSelected="True">OctetString</ComboBoxItem><ComboBoxItem>Integer32</ComboBoxItem><ComboBoxItem>Gauge32</ComboBoxItem><ComboBoxItem>Counter32</ComboBoxItem><ComboBoxItem>TimeTicks</ComboBoxItem><ComboBoxItem>IpAddress</ComboBoxItem><ComboBoxItem>ObjectIdentifier</ComboBoxItem></ComboBox><TextBlock x:Name="ValueLabel" Grid.Row="2" Text="Value" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="SetValueBox" Grid.Row="2" Grid.Column="1"/><Button x:Name="ApplySetButton" Grid.Row="2" Grid.Column="2" Style="{StaticResource AccentButton}" Content="✎  Write value" Click="ApplySet_Click"/></Grid></TabItem>
     <TabItem x:Name="InterfacesTab" Header="Interfaces"><DockPanel><Button x:Name="LoadInterfacesButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Content="↻  Load interfaces" Click="LoadInterfaces_Click"/><DataGrid x:Name="InterfacesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="MTU" Binding="{Binding Mtu}" Width="75"/><DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="110"/><DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="145"/><DataGridTextColumn Header="Admin" Binding="{Binding Admin}" Width="85"/><DataGridTextColumn Header="Operational" Binding="{Binding Operational}" Width="100"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem x:Name="IpTab" Header="IP addresses"><DockPanel><Button x:Name="LoadIpButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Content="↻  Load IP addresses" Click="LoadIp_Click"/><DataGrid x:Name="IpGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="IP address" Binding="{Binding Address}" Width="*"/><DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="110"/><DataGridTextColumn Header="Netmask" Binding="{Binding Netmask}" Width="*"/><DataGridTextColumn Header="Broadcast" Binding="{Binding Broadcast}" Width="120"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem x:Name="RoutesTab" Header="Routing"><DockPanel><Button x:Name="LoadRoutesButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Content="↻  Load routes" Click="LoadRoutes_Click"/><DataGrid x:Name="RoutesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/><DataGridTextColumn Header="Netmask" Binding="{Binding Netmask}" Width="*"/><DataGridTextColumn Header="Next hop" Binding="{Binding NextHop}" Width="*"/><DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="75"/><DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="65"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/><DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem x:Name="ArpTab" Header="ARP"><DockPanel><Button x:Name="LoadArpButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Content="↻  Load ARP table" Click="LoadArp_Click"/><DataGrid x:Name="ArpGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="IP address" Binding="{Binding Address}" Width="*"/><DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="*"/><DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="100"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem x:Name="LldpTab" Header="LLDP neighbors"><DockPanel><Button x:Name="LoadLldpButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Content="↻  Load LLDP neighbors" Click="LoadLldp_Click"/><DataGrid x:Name="LldpGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Local port" Binding="{Binding LocalPort}" Width="90"/><DataGridTextColumn Header="Chassis ID" Binding="{Binding ChassisId}" Width="150"/><DataGridTextColumn Header="Remote port" Binding="{Binding PortId}" Width="120"/><DataGridTextColumn Header="Port description" Binding="{Binding PortDescription}" Width="*"/><DataGridTextColumn Header="System name" Binding="{Binding SystemName}" Width="140"/><DataGridTextColumn Header="System description" Binding="{Binding SystemDescription}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem x:Name="LogTab" Header="Log"><TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="12" FontFamily="Consolas" BorderThickness="0"/></TabItem>
    </TabControl>
   </Grid>
   <StatusBar Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource SubtleTextBrush}"><StatusBarItem HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"/><ProgressBar x:Name="BusyBar" Grid.Column="1" Width="120" Height="12" Margin="12,0" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="BuildText" Grid.Column="2" Text="1.0.1 build11" VerticalAlignment="Center" Margin="14,0,8,0" FontWeight="SemiBold"/></Grid></StatusBarItem></StatusBar>
  </Grid>
 </DockPanel>
</Window>
