<Window x:Class="SnmpMibBrowser.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Options" Width="820" Height="590" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <GroupBox x:Name="MibFolderGroup" Header="Default MIB folder"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MibFolderBox"/><Button Grid.Column="1" x:Name="BrowseButton" Content="Browse…" Click="Browse_Click"/></Grid></GroupBox>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <GroupBox x:Name="ProfilesGroup" Header="SNMP profiles"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button x:Name="NewButton" Content="New" Click="New_Click"/><Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"/></StackPanel><ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="Name"/></DockPanel></GroupBox>
   <GroupBox Grid.Column="1" x:Name="EditorGroup" Header="Profile editor"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="NameLabel" Text="Name" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="3"/>
    <TextBlock Grid.Row="1" Text="SNMP port" VerticalAlignment="Center"/><TextBox x:Name="PortSettingsBox" Grid.Row="1" Grid.Column="1" Text="161"/>
    <TextBlock Grid.Row="2" Text="Version" VerticalAlignment="Center"/><ComboBox x:Name="VersionSettingsBox" Grid.Row="2" Grid.Column="1"><ComboBoxItem>v1</ComboBoxItem><ComboBoxItem IsSelected="True">v2c</ComboBoxItem><ComboBoxItem>v3</ComboBoxItem></ComboBox><TextBlock x:Name="CommunitySettingsLabel" Grid.Row="2" Grid.Column="2" Text="Community" VerticalAlignment="Center"/><TextBox x:Name="CommunitySettingsBox" Grid.Row="2" Grid.Column="3"/>
    <TextBlock x:Name="UserSettingsLabel" Grid.Row="3" Text="v3 user" VerticalAlignment="Center"/><TextBox x:Name="UserSettingsBox" Grid.Row="3" Grid.Column="1"/><TextBlock x:Name="ContextSettingsLabel" Grid.Row="3" Grid.Column="2" Text="Context" VerticalAlignment="Center"/><TextBox x:Name="ContextSettingsBox" Grid.Row="3" Grid.Column="3"/>
    <TextBlock x:Name="AuthSettingsLabel" Grid.Row="4" Text="Authentication" VerticalAlignment="Center"/><ComboBox x:Name="AuthSettingsBox" Grid.Row="4" Grid.Column="1"><ComboBoxItem IsSelected="True">Keine</ComboBoxItem><ComboBoxItem>MD5</ComboBoxItem><ComboBoxItem>SHA-1</ComboBoxItem><ComboBoxItem>SHA-256</ComboBoxItem><ComboBoxItem>SHA-384</ComboBoxItem><ComboBoxItem>SHA-512</ComboBoxItem></ComboBox><TextBlock x:Name="AuthPassLabel" Grid.Row="4" Grid.Column="2" Text="Auth password" VerticalAlignment="Center"/><PasswordBox x:Name="AuthPassBox" Grid.Row="4" Grid.Column="3"/>
    <TextBlock x:Name="PrivacySettingsLabel" Grid.Row="5" Text="Encryption" VerticalAlignment="Center"/><ComboBox x:Name="PrivacySettingsBox" Grid.Row="5" Grid.Column="1"><ComboBoxItem IsSelected="True">Keine</ComboBoxItem><ComboBoxItem>DES</ComboBoxItem><ComboBoxItem>AES-128</ComboBoxItem><ComboBoxItem>AES-192</ComboBoxItem><ComboBoxItem>AES-256</ComboBoxItem></ComboBox><TextBlock x:Name="PrivacyPassLabel" Grid.Row="5" Grid.Column="2" Text="Privacy password" VerticalAlignment="Center"/><PasswordBox x:Name="PrivacyPassBox" Grid.Row="5" Grid.Column="3"/>
    <Button x:Name="SaveProfileButton" Grid.Row="6" Grid.Column="1" Style="{StaticResource AccentButton}" Content="Save profile" Click="SaveProfile_Click" HorizontalAlignment="Left"/>
   </Grid></ScrollViewer></GroupBox>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="OK" Click="Ok_Click"/><Button x:Name="CancelSettingsButton" Content="Cancel" IsCancel="True"/></StackPanel>
 </Grid>
</Window>
